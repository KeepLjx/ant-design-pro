    <tr><th>指标</th><th>数值</th></tr>
    <tr><td>检查点过数</td><td>5/5</td></tr>
    <tr><td>耗时</td><td>约 8 分钟</td></tr>
    <tr><td>人工修复行数</td><td>约 690 行（修改 2 文件 +51/-8 行，新增 3 文件 639 行）</td></tr>
    <tr><td>介入次数</td><td>1 次（UTF-8 编码问题导致首次构建失败，PowerShell 重新编码后通过）</td></tr>
  </table>
</div>

<div class="section">
  <h2>八、完整源代码</h2>

  <h3>8.1 src/services/ant-design-pro/typings.d.ts（新增部分）</h3>
  <pre>
  /** 工单状态 */
  type WorkOrderStatus = 'pending' | 'processing' | 'resolved' | 'closed';

  /** 工单优先级 */
  type WorkOrderPriority = 'low' | 'medium' | 'high' | 'urgent';

  /** 工单条目 */
  type WorkOrderItem = {
    id: string;
    title: string;
    status: WorkOrderStatus;
    priority: WorkOrderPriority;
    creator: string;
    assignee: string;
    createdAt: string;
    updatedAt: string;
    description: string;
  };

  /** 工单列表响应 */
  type WorkOrderList = {
    data: WorkOrderItem[];
    total: number;
    success: boolean;
  };

  /** 工单查询参数 */
  type WorkOrderParams = {
    current?: number;
    pageSize?: number;
    status?: WorkOrderStatus;
    priority?: WorkOrderPriority;
    keyword?: string;
    startTime?: string;
    endTime?: string;
  };</pre>

  <h3>8.2 src/services/ant-design-pro/workorder.ts</h3>
  <pre>
import { request } from '@umijs/max';

/** 获取工单列表 GET /api/workorder */
export async function getWorkOrderList(
  params: API.WorkOrderParams & {
    sorter?: Record&lt;string, string&gt;;
    filter?: Record&lt;string, (string | number)[] | null&gt;;
  },
  options?: Record&lt;string, unknown&gt;,
) {
  return request&lt;API.WorkOrderList&gt;('/api/workorder', {
    method: 'GET',
    params: { ...params },
    ...(options || {}),
  });
}

/** 删除工单 DELETE /api/workorder */
export async function removeWorkOrders(
  params: { ids: string[] },
  options?: Record&lt;string, unknown&gt;,
) {
  return request&lt;{ success: boolean }&gt;('/api/workorder', {
    method: 'POST',
    data: { method: 'delete', ids: params.ids },
    ...(options || {}),
  });
}

/** 更新工单状态 POST /api/workorder */
export async function updateWorkOrderStatus(
  params: { id: string; status: API.WorkOrderStatus },
  options?: Record&lt;string, unknown&gt;,
) {
  return request&lt;{ success: boolean }&gt;('/api/workorder', {
    method: 'POST',
    data: { method: 'update', id: params.id, status: params.status },
    ...(options || {}),
  });
}</pre>

  <h3>8.3 mock/workorder.ts</h3>
  <pre>
import dayjs from 'dayjs';
import type { Request, Response } from 'express';

const statuses: API.WorkOrderStatus[] = ['pending', 'processing', 'resolved', 'closed'];
const priorities: API.WorkOrderPriority[] = ['low', 'medium', 'high', 'urgent'];
const creators = ['张三', '李四', '王五', '赵六', '孙七'];
const assignees = ['陈工', '刘工', '周工', '吴工', '郑工'];
const titlePrefixes = ['系统故障', '网络异常', '账号问题', '权限申请', '数据导出', '设备报修', '软件安装', '密码重置'];

const generateWorkOrders = (count: number): API.WorkOrderItem[] => {
  const items: API.WorkOrderItem[] = [];
  for (let i = 0; i < count; i++) {
    const status = statuses[i % 4];
    const createdAt = dayjs()
      .subtract(Math.floor(Math.random() * 30), 'day')
      .format('YYYY-MM-DD HH:mm:ss');
    items.push({
      id: `WO-${String(i + 1).padStart(5, '0')}`,
      title: `${titlePrefixes[i % titlePrefixes.length]}工单-${i + 1}`,
      status,
      priority: priorities[i % 4],
      creator: creators[i % creators.length],
      assignee: assignees[i % assignees.length],
      createdAt,
      updatedAt: dayjs(createdAt)
        .add(Math.floor(Math.random() * 5), 'hour')
        .format('YYYY-MM-DD HH:mm:ss'),
      description: `这是工单 WO-${String(i + 1).padStart(5, '0')} 的详细描述信息。`,
    });
  }
  return items;
};

const totalItems = 86;
let workOrderDataSource = generateWorkOrders(totalItems);

function getWorkOrders(req: Request, res: Response) {
  const { current = '1', pageSize = '10', status, priority, keyword, startTime, endTime, sorter } =
    req.query as Record&lt;string, string&gt;;

  let filteredData = [...workOrderDataSource];

  // 状态筛选
  if (status && statuses.includes(status as API.WorkOrderStatus)) {
    filteredData = filteredData.filter((item) => item.status === status);
  }

  // 优先级筛选
  if (priority && priorities.includes(priority as API.WorkOrderPriority)) {
    filteredData = filteredData.filter((item) => item.priority === priority);
  }

  // 关键字搜索（标题/创建人/处理人）
  if (keyword) {
    const kw = String(keyword).toLowerCase();
    filteredData = filteredData.filter(
      (item) =>
        item.title.toLowerCase().includes(kw) ||
        item.creator.toLowerCase().includes(kw) ||
        item.assignee.toLowerCase().includes(kw),
    );
  }

  // 时间范围筛选
  if (startTime) {
    filteredData = filteredData.filter((item) => item.createdAt >= startTime);
  }
  if (endTime) {
    filteredData = filteredData.filter((item) => item.createdAt <= endTime);
  }

  // 排序
  if (sorter) {
    try {
      const sortObj = JSON.parse(sorter) as Record&lt;string, string&gt;;
      const keys = Object.keys(sortObj);
      if (keys.length > 0) {
        const sortKey = keys[0] as keyof API.WorkOrderItem;
        const sortOrder = sortObj[keys[0]];
        filteredData.sort((a, b) => {
          const aVal = a[sortKey];
          const bVal = b[sortKey];
          if (aVal == null || bVal == null) return 0;
          const cmp = aVal < bVal ? -1 : aVal > bVal ? 1 : 0;
          return sortOrder === 'descend' ? -cmp : cmp;
        });
      }
    } catch {
      // ignore invalid sorter
    }
  }

  const total = filteredData.length;
  const cur = parseInt(current, 10) || 1;
  const size = parseInt(pageSize, 10) || 10;
  const start = (cur - 1) * size;
  const pagedData = filteredData.slice(start, start + size);

  res.json({ data: pagedData, total, success: true });
}

function postWorkOrder(req: Request, res: Response) {
  const body = req.body as { method?: string; ids?: string[]; id?: string; status?: API.WorkOrderStatus };

  switch (body.method) {
    case 'delete':
      if (body.ids && body.ids.length > 0) {
        workOrderDataSource = workOrderDataSource.filter((item) => !body.ids!.includes(item.id));
      }
      res.json({ success: true });
      break;
    case 'update':
      if (body.id && body.status) {
        workOrderDataSource = workOrderDataSource.map((item) =>
          item.id === body.id
            ? { ...item, status: body.status!, updatedAt: dayjs().format('YYYY-MM-DD HH:mm:ss') }
            : item,
        );
      }
      res.json({ success: true });
      break;
    default:
      res.json({ success: false });
  }
}

export default {
  'GET /api/workorder': getWorkOrders,
  'POST /api/workorder': postWorkOrder,
};</pre>

  <h3>8.4 src/pages/workorder/index.tsx（完整源代码）</h3>
  <pre>
import type { ActionType, ProColumns } from '@ant-design/pro-components';
import {
  FooterToolbar,
  PageContainer,
  ProTable,
} from '@ant-design/pro-components';
import { useMutation, useQueryClient } from '@tanstack/react-query';
import {
  Button,
  Empty,
  Modal,
  Result,
  Space,
  Tag,
  message,
  type TablePaginationConfig,
} from 'antd';
import React, { useCallback, useRef, useState } from 'react';
import {
  getWorkOrderList,
  removeWorkOrders,
  updateWorkOrderStatus,
} from '@/services/ant-design-pro/workorder';

/** 状态颜色映射：复用 antd Tag 预设色 */
const statusColorMap: Record&lt;API.WorkOrderStatus, string&gt; = {
  pending: 'default',
  processing: 'processing',
  resolved: 'success',
  closed: 'error',
};

/** 优先级颜色映射 */
const priorityColorMap: Record&lt;API.WorkOrderPriority, string&gt; = {
  low: 'default',
  medium: 'blue',
  high: 'orange',
  urgent: 'red',
};

/** 状态文案 */
const statusLabelMap: Record&lt;API.WorkOrderStatus, string&gt; = {
  pending: '待处理',
  processing: '处理中',
  resolved: '已解决',
  closed: '已关闭',
};

/** 优先级文案 */
const priorityLabelMap: Record&lt;API.WorkOrderPriority, string&gt; = {
  low: '低',
  medium: '中',
  high: '高',
  urgent: '紧急',
};

/** 分页配置 */
const paginationConfig: Partial&lt;TablePaginationConfig&gt; = {
  defaultPageSize: 10,
  showSizeChanger: true,
  pageSizeOptions: ['10', '20', '50', '100'],
  showTotal: (total: number, range: [number, number]) =>
    `${range[0]}-${range[1]} / 共 ${total} 条`,
};

const WorkOrderList: React.FC = () => {
  const actionRef = useRef&lt;ActionType | null&gt;(null);
  const queryClient = useQueryClient();
  const [messageApi, contextHolder] = message.useMessage();

  const [selectedRowKeys, setSelectedRowKeys] = useState&lt;string[]&gt;([]);
  const [selectedRows, setSelectedRows] = useState&lt;API.WorkOrderItem[]&gt;([]);
  const [errorInfo, setErrorInfo] = useState&lt;{ message: string; retry: () => void } | null&gt;(null);

  // ---- 删除 mutation ----
  const { mutateAsync: runRemove, isPending: removing } = useMutation({
    mutationFn: removeWorkOrders,
    onSuccess: () => {
      messageApi.success('删除成功');
      setSelectedRowKeys([]);
      setSelectedRows([]);
      actionRef.current?.reloadAndRest?.();
      queryClient.invalidateQueries({ queryKey: ['workorder'] });
    },
    onError: () => {
      messageApi.error('删除失败，请重试');
    },
  });

  // ---- 状态更新 mutation ----
  const { mutateAsync: runUpdateStatus, isPending: updating } = useMutation({
    mutationFn: updateWorkOrderStatus,
    onSuccess: () => {
      messageApi.success('状态更新成功');
      actionRef.current?.reloadAndRest?.();
      queryClient.invalidateQueries({ queryKey: ['workorder'] });
    },
    onError: () => {
      messageApi.error('状态更新失败，请重试');
    },
  });

  // ---- 批量删除 ----
  const handleBatchDelete = useCallback(() => {
    if (selectedRowKeys.length === 0) {
      messageApi.warning('请先选择要删除的工单');
      return;
    }
    Modal.confirm({
      title: '确认批量删除',
      content: `确定要删除选中的 ${selectedRowKeys.length} 条工单吗？此操作不可撤销。`,
      okText: '确认删除',
      cancelText: '取消',
      okType: 'danger',
      onOk: async () => {
        await runRemove({ ids: selectedRowKeys });
      },
    });
  }, [selectedRowKeys, runRemove, messageApi]);

  // ---- 批量关闭 ----
  const handleBatchClose = useCallback(() => {
    if (selectedRowKeys.length === 0) {
      messageApi.warning('请先选择要关闭的工单');
      return;
    }
    Modal.confirm({
      title: '确认批量关闭',
      content: `确定要关闭选中的 ${selectedRowKeys.length} 条工单吗？`,
      okText: '确认关闭',
      cancelText: '取消',
      onOk: async () => {
        const promises = selectedRowKeys.map((id) =>
          updateWorkOrderStatus({ id, status: 'closed' }),
        );
        await Promise.all(promises);
        messageApi.success('批量关闭成功');
        setSelectedRowKeys([]);
        setSelectedRows([]);
        actionRef.current?.reloadAndRest?.();
        queryClient.invalidateQueries({ queryKey: ['workorder'] });
      },
    });
  }, [selectedRowKeys, messageApi, actionRef, queryClient]);

  // ---- 单条操作：更新状态 ----
  const handleSingleStatusChange = useCallback(
    (record: API.WorkOrderItem, newStatus: API.WorkOrderStatus) => {
      Modal.confirm({
        title: '确认更改状态',
        content: `确定要将工单「${record.title}」的状态从「${statusLabelMap[record.status]}」更改为「${statusLabelMap[newStatus]}」吗？`,
        okText: '确认',
        cancelText: '取消',
        onOk: async () => {
          await runUpdateStatus({ id: record.id, status: newStatus });
        },
      });
    },
    [runUpdateStatus],
  );

  // ---- 单条操作：删除 ----
  const handleSingleDelete = useCallback(
    (record: API.WorkOrderItem) => {
      Modal.confirm({
        title: '确认删除',
        content: `确定要删除工单「${record.title}」吗？此操作不可撤销。`,
        okText: '确认删除',
        cancelText: '取消',
        okType: 'danger',
        onOk: async () => {
          await runRemove({ ids: [record.id] });
        },
      });
    },
    [runRemove],
  );

  // ---- 列定义 ----
  const columns: ProColumns&lt;API.WorkOrderItem&gt;[] = [
    {
      title: '工单编号',
      dataIndex: 'id',
      width: 140,
      copyable: true,
      ellipsis: true,
      fixed: 'left',
    },
    {
      title: '工单标题',
      dataIndex: 'title',
      width: 220,
      ellipsis: true,
      fieldProps: {
        placeholder: '请输入工单标题搜索',
      },
    },
    {
      title: '状态',
      dataIndex: 'status',
      width: 100,
      sorter: true,
      filters: true,
      valueType: 'select',
      valueEnum: {
        pending: { text: '待处理', status: 'Default' },
        processing: { text: '处理中', status: 'Processing' },
        resolved: { text: '已解决', status: 'Success' },
        closed: { text: '已关闭', status: 'Error' },
      },
      render: (_, record) => (
        &lt;Tag color={statusColorMap[record.status]}&gt;{statusLabelMap[record.status]}&lt;/Tag&gt;
      ),
    },
    {
      title: '优先级',
      dataIndex: 'priority',
      width: 90,
      sorter: true,
      filters: true,
      valueType: 'select',
      valueEnum: {
        low: { text: '低' },
        medium: { text: '中' },
        high: { text: '高' },
        urgent: { text: '紧急' },
      },
      render: (_, record) => (
        &lt;Tag color={priorityColorMap[record.priority]}&gt;{priorityLabelMap[record.priority]}&lt;/Tag&gt;
      ),
    },
    {
      title: '创建人',
      dataIndex: 'creator',
      width: 100,
      sorter: true,
    },
    {
      title: '处理人',
      dataIndex: 'assignee',
      width: 100,
      sorter: true,
    },
    {
      title: '创建时间',
      dataIndex: 'createdAt',
      width: 180,
      sorter: true,
      valueType: 'dateTime',
      search: false,
    },
    {
      title: '更新时间',
      dataIndex: 'updatedAt',
      width: 180,
      sorter: true,
      valueType: 'dateTime',
      search: false,
    },
    {
      title: '时间范围',
      dataIndex: 'timeRange',
      valueType: 'dateRange',
      hideInTable: true,
      search: {
        transform: (value: [string, string]) => ({
          startTime: value[0],
          endTime: value[1],
        }),
      } as ProColumns&lt;API.WorkOrderItem&gt;['search'],
      fieldProps: {
        placeholder: ['开始日期', '结束日期'],
      },
    },
    {
      title: '操作',
      dataIndex: 'option',
      valueType: 'option',
      width: 220,
      fixed: 'right',
      render: (_, record) => (
        &lt;Space size="small"&gt;
          {record.status === 'pending' && (
            &lt;Button type="link" size="small" loading={updating}
              onClick={() => handleSingleStatusChange(record, 'processing')}&gt;接单&lt;/Button&gt;
          )}
          {record.status === 'processing' && (
            &lt;Button type="link" size="small" loading={updating}
              onClick={() => handleSingleStatusChange(record, 'resolved')}&gt;解决&lt;/Button&gt;
          )}
          {(record.status === 'pending' || record.status === 'processing') && (
            &lt;Button type="link" size="small" loading={updating}
              onClick={() => handleSingleStatusChange(record, 'closed')}&gt;关闭&lt;/Button&gt;
          )}
          {record.status === 'closed' && (
            &lt;Button type="link" size="small" loading={updating}
              onClick={() => handleSingleStatusChange(record, 'pending')}&gt;重开&lt;/Button&gt;
          )}
          &lt;Button type="link" size="small" danger loading={removing}
            onClick={() => handleSingleDelete(record)}&gt;删除&lt;/Button&gt;
        &lt;/Space&gt;
      ),
    },
  ];

  // ---- 请求数据（包含错误处理）----
  const handleRequest = useCallback(
    async (
      params: Record&lt;string, unknown&gt; & {
        pageSize?: number;
        current?: number;
        keyword?: string;
      },
      sort: Record&lt;string, unknown&gt;,
      filter: Record&lt;string, (string | number)[] | null&gt;,
    ) => {
      setErrorInfo(null);
      try {
        const result = await getWorkOrderList({
          ...params,
          sorter: sort as Record&lt;string, string&gt;,
          filter: filter as Record&lt;string, (string | number)[] | null&gt;,
        });
        return { data: result.data, success: result.success, total: result.total };
      } catch (err: unknown) {
        const errorMessage = err instanceof Error ? err.message : '网络请求失败，请检查网络后重试';
        setErrorInfo({ message: errorMessage, retry: () => actionRef.current?.reload() });
        return { data: [], success: false, total: 0 };
      }
    },
    [],
  );

  return (
    &lt;PageContainer&gt;
      {contextHolder}
      {errorInfo ? (
        &lt;Result
          status="error"
          title="数据加载失败"
          subTitle={errorInfo.message}
          extra={&lt;Button type="primary" onClick={errorInfo.retry}&gt;重新加载&lt;/Button&gt;}
        /&gt;
      ) : (
        &lt;ProTable&lt;API.WorkOrderItem, API.WorkOrderParams&gt;
          headerTitle="工单列表"
          actionRef={actionRef}
          rowKey="id"
          search={{ labelWidth: 80, defaultCollapsed: false, span: 8 }}
          options={{ density: true, fullScreen: true, reload: true, setting: true }}
          pagination={paginationConfig}
          request={handleRequest}
          columns={columns}
          scroll={{ x: 1300 }}
          rowSelection={{
            selectedRowKeys,
            onChange: (keys: React.Key[], rows: API.WorkOrderItem[]) => {
              setSelectedRowKeys(keys as string[]);
              setSelectedRows(rows);
            },
            getCheckboxProps: (record: API.WorkOrderItem) => ({
              disabled: record.status === 'closed',
            }),
          }}
          tableAlertRender={false}
          locale={{
            emptyText: (
              &lt;Empty image={Empty.PRESENTED_IMAGE_SIMPLE} description="暂无工单数据" /&gt;
            ),
          }}
          loading={removing}
        /&gt;
      )}

      {selectedRowKeys.length > 0 && (
        &lt;FooterToolbar
          extra={
            &lt;span&gt;
              已选择{' '}
              &lt;span style={{ fontWeight: 600 }}&gt;{selectedRowKeys.length}&lt;/span&gt;{' '}
              项工单
            &lt;/span&gt;
          }
        &gt;
          &lt;Button loading={removing} onClick={handleBatchDelete}&gt;批量删除&lt;/Button&gt;
          &lt;Button type="primary" onClick={handleBatchClose}&gt;批量关闭&lt;/Button&gt;
        &lt;/FooterToolbar&gt;
      )}
    &lt;/PageContainer&gt;
  );
};

export default WorkOrderList;</pre>

  <h3>8.5 config/routes.ts（新增路由）</h3>
